# ---------------------------------------------------------------------------
# Jarvis Personal OS — secrets template
# Copy this file to  .streamlit/secrets.toml  and fill in the values.
# NEVER commit the real secrets.toml to git.
# ---------------------------------------------------------------------------

# --- Google OAuth (native Streamlit OIDC login) ----------------------------
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID"  ->  type: "Web application"
# 3. Under "Authorized redirect URIs" add EXACTLY:
#        https://apnabihar.online/oauth2callback
#    (for local testing also add: http://localhost:8501/oauth2callback)
# 4. Copy the Client ID and Client Secret below.
# 5. cookie_secret can be ANY long random string. Generate one with:
#        python -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri = "https://apnabihar.online/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
